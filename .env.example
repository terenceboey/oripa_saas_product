# Core
NODE_ENV=development
APP_PORT=4000
WEB_PORT=3000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TENANT_HOST=demo.localhost

# Data
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oripa_saas?schema=public
REDIS_URL=redis://localhost:6379
DISABLE_DRAW_QUEUE=true

# Tenant defaults
DEFAULT_TENANT_SLUG=demo-vendor
DEFAULT_TENANT_HOST=demo.localhost

# Security
JWT_SECRET=change-me

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# Email delivery for OTP (optional in dev; logs OTP to API console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# OAuth (Apple)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_CALLBACK_URL=http://localhost:4000/v1/auth/apple/callback
